# systemd unit for the FlightDesk server. Installed by deploy.sh to
# /etc/systemd/system/flightdesk-server.service.
#
# The config file is read by systemd (as root) before privileges are dropped, so
# /etc/flightdesk/flightdesk.env can stay root:root 0600 and the token is never
# readable by the service's own (dynamic, unprivileged) user or anyone else.
# Check the sandbox after installing:  systemd-analyze security flightdesk-server

[Unit]
Description=FlightDesk server (shared flight data cache and history)
Documentation=https://github.com/BadWasabeee/flightdesk/tree/main/Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/flightdesk-server serve
EnvironmentFile=/etc/flightdesk/flightdesk.env
# Keep the Go heap well under MemoryMax so the GC works harder before the kernel steps in.
Environment=GOMEMLIMIT=180MiB
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

# Unprivileged throwaway user; data in /var/lib/flightdesk (the default FLIGHTDESK_DATA_DIR).
DynamicUser=yes
StateDirectory=flightdesk
StateDirectoryMode=0750
UMask=0077

# Resources
MemoryMax=256M
MemoryHigh=224M
TasksMax=64
LimitNOFILE=4096

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
