# FlightDesk server configuration: /etc/flightdesk/flightdesk.env (root:root, mode 0600).
# deploy.sh creates this file once, with a fresh token, and never overwrites it.
# After editing:  sudo systemctl restart flightdesk-server

# Bearer token the apps send (required, >= 32 characters). Generate: flightdesk-server token
FLIGHTDESK_TOKEN=

# Where to listen. Keep it on loopback behind nginx/Caddy (TLS) or a VPN.
FLIGHTDESK_LISTEN=127.0.0.1:8787

# The area polled continuously: centre and radius in nautical miles (1-250; 0 turns the poller off).
FLIGHTDESK_CENTER_LAT=
FLIGHTDESK_CENTER_LON=
FLIGHTDESK_RADIUS_NM=0

# Area poll interval (5s-60s) and watched-flight poll interval (30s-5m).
FLIGHTDESK_POLL_INTERVAL=8s
FLIGHTDESK_WATCH_INTERVAL=45s
FLIGHTDESK_MAX_WATCHES=20

# Retention: full-detail tracks, downsampled (1 point / 5 min) tracks, ACARS messages.
# Leg metadata and the sightings log are kept forever (they are tiny).
FLIGHTDESK_RETAIN_DETAIL_DAYS=90
FLIGHTDESK_RETAIN_COARSE_DAYS=730
FLIGHTDESK_RETAIN_ACARS_DAYS=180

# Hard cap on the database size; the oldest detail is pruned first when it is exceeded.
FLIGHTDESK_DISK_CAP_GB=15
# Hour (server local time) for the nightly retention run.
FLIGHTDESK_MAINTENANCE_HOUR=3

# Requests per minute per client IP.
FLIGHTDESK_RATE_LIMIT_PER_MIN=240
# Trust X-Real-IP / X-Forwarded-For from a reverse proxy on 127.0.0.1.
FLIGHTDESK_TRUST_PROXY=true

# FLIGHTDESK_DATA_DIR=/var/lib/flightdesk
# FLIGHTDESK_LOG_LEVEL=info      # debug | info | warn | error
# FLIGHTDESK_LOG_FORMAT=json     # json | text
