// Shared build configuration. Override any of these in Config/Local.xcconfig (git-ignored);
// ./build.sh creates that file for you on first run.

// Your Apple Developer Team ID (a free Apple ID works). Required: widgets must be signed.
DEVELOPMENT_TEAM =

// Reverse-DNS prefix for the app and widget bundle identifiers.
BUNDLE_ID_PREFIX = io.github.badwasabeee

// App Group shared by the app and widget. On macOS this must start with your Team ID.
APP_GROUP_ID = $(DEVELOPMENT_TEAM).$(BUNDLE_ID_PREFIX).flightdesk

// The iPhone app and its widget share this App Group. iOS requires the "group." form (a
// Team-ID-prefixed group can't be provisioned for a device).
IOS_APP_GROUP_ID = group.$(BUNDLE_ID_PREFIX).flightdesk

// Keychain access group the iPhone app and its widget share (the FlightDesk server token), used
// as $(AppIdentifierPrefix)$(IOS_KEYCHAIN_GROUP). The Mac app and widget are signed without a
// provisioning profile, which macOS requires for keychain-access-groups, so on the Mac the token
// lives in the login keychain with an access list naming the app and widget (Shared/Keychain.swift).
IOS_KEYCHAIN_GROUP = $(BUNDLE_ID_PREFIX).flightdesk.shared

#include? "Local.xcconfig"
